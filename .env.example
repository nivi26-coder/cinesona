# Atlas → Cluster0 → Connect → Drivers. Replace <user> and <password>.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.nlx4fgh.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"
# Cinesona's own database (the `titles` collection).
MONGODB_DB="cinesona"
# Read-only source: the Atlas sample dataset (movies to import, comments).
MFLIX_DB="sample_mflix"

# TMDB → https://www.themoviedb.org/settings/api → "API Read Access Token".
# Imports series/anime/newer movies, and powers trailers + where-to-watch.
TMDB_API_TOKEN=""
# Two-letter country code for where-to-watch (US, IN, GB…).
WATCH_REGION="US"

# IGDB (games) → https://dev.twitch.tv/console → Register Your Application.
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""
